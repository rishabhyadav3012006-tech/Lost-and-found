# ── Environment Configuration ─────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it's already in .gitignore.

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default — path is relative to project root inside the container)
DATABASE_URL=sqlite:///./backend/reunite.db

# ─── Security ────────────────────────────────────────────────────────────────
# REQUIRED: Generate a strong secret key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32

# ─── App ─────────────────────────────────────────────────────────────────────
DEBUG=false
# Your server's public URL (used in emails, CORS)
APP_URL=https://your-domain.com

# ─── CORS ────────────────────────────────────────────────────────────────────
# Add your production frontend URL here (edit config.py ALLOWED_ORIGINS too)
# e.g., https://your-domain.com

# ─── Email / SMTP (optional) ─────────────────────────────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=ReUnite AI
SMTP_FROM_EMAIL=
